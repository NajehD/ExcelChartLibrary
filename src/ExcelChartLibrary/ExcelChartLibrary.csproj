<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ExcelChartLibrary</RootNamespace>
    <AssemblyName>ExcelChartLibrary</AssemblyName>
    <Version>1.0.0</Version>
    <Description>OutSystems ODC external library that exports Excel sheets with charts using NPOI.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- NPOI pinned to 2.7.4: the last version under a pure Apache 2.0 license.
         2.8.0+ requires the OSMF (Open Source Maintenance Fee) EULA for commercial use. -->
    <PackageReference Include="NPOI" Version="2.7.4" />
    <PackageReference Include="OutSystems.ExternalLibraries.SDK" Version="1.5.0" />
  </ItemGroup>

</Project>
